#Kafka Settings
KAFKA_BROKER_ADDRESS=redpanda-0:9092
KAFKA_OUTPUT_TOPIC=tmi
BUFFER_SIZE=10000

# Training Settings: last_quarter, historical (the last YEARS years) or quarter (YEAR and QUARTER)
MODE=last_quarter
YEARS=1
# YEAR=2026
# QUARTER=3
# Random publication order, so a scrape stopped early is a random sample
SHUFFLE=False
