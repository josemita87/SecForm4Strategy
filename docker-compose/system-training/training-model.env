FEATURE_GROUP_VERSION=1

# Training settings (docs/training.md): the latest 20% of rows are the holdout, the rest is cross-validated in 4 folds
HOLDOUT_RATIO=0.2
N_FOLDS=4
# Evaluation shorts below this predicted return; keep it equal to inference-model.env
PREDICTION_THRESHOLD=-0.05
RANDOM_STATE=42
TARGET_FEATURE=pct_change

# Artifacts, shared with inference through the .artifacts volume
MODEL_STORE__BACKEND=local
MODEL_STORE__PATH=/artifacts/model.joblib
PLOT_PATH=/artifacts/simulation.png
