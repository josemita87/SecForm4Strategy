# Ignore virtual environment folders
venv/
env/
.venv/

# Ignore .pyc, .pyo, .pyd files (compiled files)
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Ignore site-packages (dependencies installed by pip, poetry, etc.)
site-packages/

# Ignore all logs, databases, temporary files, etc.
*.log
*.db
*.sqlite3

# Ignore macOS / IDE and editor-specific files
.DS_Store
.vscode/
.claude/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore sensitive credentials files
**/.credentials.env

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/


# Ignore any other unnecessary files (generated files)
*.swp
*.tmp

# Trained model artifacts (produced by training, not versioned)
*.joblib

# Local Iceberg feature store (catalog + warehouse)
.lakehouse/
