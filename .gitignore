# Ignore virtual environment folders
venv/
env/
.venv/

# Ignore .pyc, .pyo, .pyd files (compiled files)
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Ignore site-packages (dependencies installed by pip, poetry, etc.)
site-packages/

# Ignore all logs, databases, temporary files, etc.
*.log
*.db
*.sqlite3

# Ignore macOS / IDE and editor-specific files
.DS_Store
.vscode/
.claude/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore sensitive credentials files
**/.credentials.env

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/


# Ignore any other unnecessary files (generated files)
*.swp
*.tmp

# Trained model artifacts (produced by training, not versioned)
*.joblib

# Local Iceberg feature store (catalog + warehouse)
.lakehouse/

# Model artifacts shared by the training and inference containers
.artifacts/

# Claude Code MCP servers (local tooling)
.mcp.json

# Terraform vars
.terraform/
*.tfstate
*.tfvars
!*.tfvars.example
# The on/off switch is committed, so every apply, local or CI, uses the same value
!switch.auto.tfvars
tfplan

# Internal presentation pack and its PDF
docs/presentation/

# Site data the publisher writes; previews use site/fixtures
site/data/

# Built from docs/report/report.md; submitted as a file, not tracked
docs/report/report.pdf
